# Milestone 12C staging rollout — operator environment contract.
# PLACEHOLDERS ONLY. Never commit a real key, password, token or DSN here.
#
# Copy to a file OUTSIDE the repository (or to `.env.staging`, which is
# gitignored) and fill the values from the operator secret store:
#
#   set -a; . ../aish-secrets/staging.env; set +a
#
# Every `tool/*_staging*` script reads these from the process environment and
# never echoes a value back.

# --- Target identity -------------------------------------------------------
APP_ENV=staging
AISH_TARGET_ENV=staging
AISH_STAGING_CONFIRM=I_UNDERSTAND_THIS_IS_STAGING

# Host allowlist. A script refuses to run unless the resolved SUPABASE_URL host
# is listed here, so a mistyped or copy-pasted production URL fails closed
# instead of being trusted because a variable happened to be named "staging".
# Comma separated, exact host match, no wildcards.
AISH_STAGING_HOST_ALLOWLIST=example-staging.supabase.co

# Project ref allowlist, checked against the label parsed out of SUPABASE_URL.
AISH_STAGING_PROJECT_REF_ALLOWLIST=example-staging

# --- Supabase endpoint -----------------------------------------------------
SUPABASE_URL=https://example-staging.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-anon-key

# Service-role key. Operator tooling only. It is never shipped to Flutter, never
# written to an artifact, and never printed. Leave unset for read-only checks.
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

# --- Contract expectations -------------------------------------------------
SUPABASE_EXPECTED_SERVER_REVISION=aish-supabase-003

# --- Fixture and safety policy ---------------------------------------------
STAGING_TEST_NAMESPACE=aish-12c-staging
STAGING_ALLOW_DESTRUCTIVE_OPERATIONS=false

# Password used for the throwaway fixture accounts the staging E2E harnesses
# create and deactivate inside their own namespace. Must be supplied by the
# operator; there is no default.
STAGING_FIXTURE_PASSWORD=replace-with-a-throwaway-staging-only-password

# --- Backfill ---------------------------------------------------------------
# Baseline marker revision. Two runs sharing this value can never journal the
# same entity twice, whatever their run ids are.
AISH_BACKFILL_REVISION=aish-supabase-003-baseline
AISH_BACKFILL_BATCH_SIZE=500

# --- Retention planning -----------------------------------------------------
# Days a device may stay offline before it is expected to resync from zero.
# Drives the proposed prune boundary; nothing is ever deleted by the planner.
AISH_JOURNAL_SAFETY_WINDOW_DAYS=30
