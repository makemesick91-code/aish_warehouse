# Milestone 12C production canary — operator environment contract.
# PLACEHOLDERS ONLY. Never commit a real key, password, token, ref or DSN here.
#
# This is a SEPARATE contract from `.env.staging.example`. Never load both into
# the same shell: every production tool refuses to start if a `AISH_STAGING_*`
# variable is present, because two live contracts in one shell is how the wrong
# one gets used.
#
# Copy to a file OUTSIDE the repository (or to `.env.production`, which is
# gitignored) and fill the values from the operator secret store:
#
#   set -a; . ../aish-secrets/production.env; set +a
#
# Every `tool/*production*` script reads these from the process environment and
# never echoes a value back.

# --- Target identity -------------------------------------------------------
APP_ENV=production
AISH_TARGET_ENV=production

# First confirmation. Exact string, no substitutes. The staging token
# (I_UNDERSTAND_THIS_IS_STAGING) is refused here, and this token is refused by
# the staging tools.
AISH_PRODUCTION_CONFIRM=I_UNDERSTAND_THIS_TARGETS_PRODUCTION

# The production project ref, exact. It is matched against the label parsed out
# of SUPABASE_URL; a mismatch is a refusal, not a warning.
AISH_PRODUCTION_PROJECT_REF=replace-with-production-project-ref

# Second confirmation: restate the project ref, character for character. A
# copied environment file already carries the token above; restating the ref is
# a separate act. At a terminal the runner asks for it a third time.
AISH_PRODUCTION_SECOND_CONFIRM=replace-with-production-project-ref

# Exactly one host. No wildcards, no comma-separated list — production is one
# project, and a list is how a second one gets in.
AISH_PRODUCTION_ALLOWED_HOST=replace-with-production-project-ref.supabase.co

# The branch production commands may be driven from. Asserted against the
# working tree, which must also be clean.
AISH_PRODUCTION_ALLOWED_BRANCH=chore/12c-staging-rollout

# --- Change control --------------------------------------------------------
# The approved change record. Appears in every audit artifact.
AISH_CHANGE_TICKET=CHG-0000

# The approved window, as an ISO 8601 interval. `now` must fall inside it or
# every production tool refuses. Maximum span is 12 hours: a window wide enough
# to cover a working week is a standing permission, not a window.
AISH_MAINTENANCE_WINDOW=2026-08-10T22:00:00Z/2026-08-11T02:00:00Z

# Who is running this. A name or operator id, recorded in the audit artifact.
AISH_OPERATOR_ACKNOWLEDGEMENT=replace-with-operator-name-or-id

# --- Backup blocker --------------------------------------------------------
# The retrievable identifier of the backup taken before this change. There is
# no default and no bypass: without it, nothing runs.
AISH_BACKUP_IDENTIFIER=replace-with-backup-identifier

# Optional checksum of that backup, recorded alongside the identifier.
AISH_BACKUP_SHA256=

# Set to `true` only after the backup has actually been restored into a scratch
# database and read. An unrestored dump is a hope, not a rollback plan.
AISH_RESTORE_REHEARSAL_CONFIRMED=false

# --- Supabase endpoint -----------------------------------------------------
SUPABASE_URL=https://replace-with-production-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-production-anon-key

# Service-role key. Operator tooling only. Never shipped to Flutter, never
# written to an artifact, never printed. Leave unset for the read-only tools.
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key

# --- Contract expectations -------------------------------------------------
SUPABASE_EXPECTED_SERVER_REVISION=aish-supabase-003

# --- Write authorisation ---------------------------------------------------
# Every production tool is read-only or dry-run by default. A tool that writes
# must request a named scope, and that scope must be granted here. Leave empty
# for every read-only step of the runbook.
#
#   journal_baseline  — the backfill driver: inserts journal + field-version
#                       rows through the admin RPC. Touches no business column.
#   canary_namespace  — the canary harnesses: create and retire their own
#                       branches, rooms, items, users and documents. Never touch
#                       a row they did not create.
#
# Comma separated. There is no `all`.
AISH_PRODUCTION_WRITE_SCOPE=

# --- Canary namespace ------------------------------------------------------
AISH_PRODUCTION_CANARY_NAMESPACE=aish-prod-canary

# Password for the throwaway canary accounts the harnesses create inside their
# own namespace and then ban. Must be supplied by the operator; no default.
AISH_PRODUCTION_CANARY_PASSWORD=replace-with-a-throwaway-canary-only-password

# --- Backfill canary -------------------------------------------------------
AISH_BACKFILL_REVISION=aish-supabase-003-baseline

# Small on purpose. The driver caps it at 100 and refuses an unbounded run:
# --max-batches is mandatory on every invocation.
AISH_PRODUCTION_BACKFILL_BATCH_SIZE=25

# --- Invariants ------------------------------------------------------------
# Upper bound on rows read when checksumming stock balances between batches.
# Above this the verifier switches to a deterministic bounded sample and says so
# in the report rather than reading the whole table on production.
AISH_PRODUCTION_INVARIANT_SAMPLE=5000
