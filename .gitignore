# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
node_modules/

# Environment and Supabase local state. The example contracts remain tracked;
# they carry variable names and placeholders only, never a value.
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example
config/supabase.dev.json
config/supabase.staging.json
config/supabase.production.json

# Rollout artifacts, staging and production alike. Verification, backfill and
# benchmark reports name the target project, the change ticket, the operator and
# the fixture or canary actors that ran against it, so they stay local and are
# attached to the rollout ticket by hand rather than committed.
artifacts/
supabase/.env
supabase/functions/.env
supabase/.temp/
supabase/.branches/

# Graphify dependency-graph output (build artifact, regenerate with
# `graphify update .`)
graphify-out/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
